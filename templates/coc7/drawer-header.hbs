{{!-- Call of Cthulhu 7e Header Template (character, npc, creature) --}}
<div class="header-top coc7-header">
  <div class="avatar-container">
    <img class="header-avatar" src="{{actor.img}}" alt="">
  </div>
  <div class="header-info">
    <h1 class="char-name">{{actor.name}}</h1>
    {{#if subtitle}}<span class="char-details">{{subtitle}}</span>{{/if}}
    <div class="hp-display" data-action="openResourceDialog" data-resource="hp" title="{{hp.title}}">
      <div class="hp-group">
        <span class="hp-current">{{hp.value}}</span>
      </div>
      <span class="hp-separator">/</span>
      <div class="hp-group">
        <span class="hp-max">{{hp.max}}</span>
      </div>
    </div>
  </div>
</div>
<div class="hp-bar-thin">
  <div class="hp-bar-fill" style="flex: 0 0 {{hp.percent}}%"></div>
</div>
