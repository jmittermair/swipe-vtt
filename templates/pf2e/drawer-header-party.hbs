<div class="header-top">
  <div class="avatar-container">
    <img class="header-avatar" src="{{actor.img}}" alt="">
  </div>
  <div class="header-info">
    <h1 class="char-name">{{actor.name}}</h1>
    <span class="char-details">
      <i class="fa-solid fa-users"></i> {{memberCount}} members{{#if level}} · Avg Level {{level}}{{/if}}
    </span>
  </div>
</div>
