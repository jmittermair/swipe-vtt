{{!-- Daggerheart PC Header Template --}}
<div class="header-top dh-header">
  <div class="avatar-container">
    <img class="header-avatar" src="{{actor.img}}" alt="">
  </div>
  <div class="header-info">
    <h1 class="char-name">{{actor.name}}</h1>

    <div class="char-details">
      {{classText}}
      {{#if heritage}}<span class="char-race">{{heritage}}</span>{{/if}}
    </div>
    
    <div class="dh-resources-row">
      <div class="dh-resource" data-action="openHpDialog">
        <span class="resource-label">HP</span>
        <span class="resource-value">{{hp.value}}<span class="resource-max">/{{hp.max}}</span></span>
      </div>
      <div class="dh-resource" data-action="openStressDialog">
        <span class="resource-label">Stress</span>
        <span class="resource-value stress-value">{{stress.value}}<span class="resource-max">/{{stress.max}}</span></span>
      </div>
    </div>
  </div>
</div>
<div class="dh-bars-row">
  <div class="dh-bar hp-bar">
    <div class="bar-fill" style="width: {{hp.percent}}%"></div>
  </div>
  <div class="dh-bar stress-bar">
    <div class="bar-fill" style="width: {{stress.percent}}%"></div>
  </div>
</div>
