<div class="mobile-button-stack">
  <button class="mobile-stack-btn freeze-indicator-btn" data-action="unfreeze" title="{{localize 'SWIPE_VTT.CanvasFreeze.RefreshTooltip'}}" style="display: none;">
    <i class="fas fa-arrows-rotate"></i>
  </button>
  <button class="mobile-stack-btn dice-roller-btn" data-action="dice" title="{{localize 'SWIPE_VTT.DiceRoller.Title'}}">
    <i class="fa-solid fa-dice-d20"></i>
  </button>
  <button class="mobile-stack-btn macro-toggle-btn" data-action="macro" title="Macro Hotbar" style="display: none;">
    <i class="fa-solid fa-code"></i>
  </button>
  <button class="mobile-stack-btn chat-toggle-btn" data-action="chat" title="{{localize 'SWIPE_VTT.Chat.ToggleTooltip'}}" style="display: none;">
    <i class="fas fa-comments"></i>
  </button>
</div>
